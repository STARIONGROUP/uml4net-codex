{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/STARIONGROUP/uml4net-sage/knowledge/metamodel.schema.json",
  "title": "uml4net-sage metamodel.json",
  "description": "The full UML metamodel class/enumeration/primitive-type/association graph, with precomputed inheritance closures, generated by Uml4Net.Sage.MetamodelGen. Written to knowledge/<version>/metamodel/metamodel.json.",
  "type": "object",
  "required": ["classes", "enumerations", "primitiveTypes", "associations"],
  "additionalProperties": false,
  "properties": {
    "classes": { "type": "array", "items": { "$ref": "#/definitions/classNode" } },
    "enumerations": { "type": "array", "items": { "$ref": "#/definitions/enumerationNode" } },
    "primitiveTypes": { "type": "array", "items": { "$ref": "#/definitions/primitiveTypeNode" } },
    "associations": { "type": "array", "items": { "$ref": "#/definitions/associationNode" } }
  },
  "definitions": {
    "feature": {
      "type": "object",
      "required": ["name", "kind", "lower", "upper", "isDerived", "isOrdered", "isUnique", "isComposite", "redefines", "subsets", "ownerQualifiedName", "parameters", "isStatic", "isReadOnly", "isDerivedUnion", "isQuery", "isAbstract"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["attribute", "operation"] },
        "typeName": { "type": ["string", "null"] },
        "typeQualifiedName": { "type": ["string", "null"] },
        "lower": { "type": "integer" },
        "upper": { "type": "string", "description": "\"*\" for unbounded, otherwise a non-negative integer as a string" },
        "isDerived": { "type": "boolean" },
        "isOrdered": { "type": "boolean" },
        "isUnique": { "type": "boolean" },
        "isComposite": { "type": "boolean" },
        "redefines": { "type": "array", "items": { "type": "string" } },
        "subsets": { "type": "array", "items": { "type": "string" } },
        "ownerQualifiedName": { "type": "string" },
        "parameters": {
          "type": "array",
          "description": "An operation's in/inout/out parameters in declaration order (the return parameter is instead represented by this feature's own typeName/lower/upper); always empty for an attribute.",
          "items": { "$ref": "#/definitions/parameter" }
        },
        "isStatic": { "type": "boolean" },
        "isReadOnly": { "type": "boolean", "description": "Always false for an operation." },
        "isDerivedUnion": { "type": "boolean", "description": "True when the attribute's value is the union of every property that subsets it; always false for an operation." },
        "aggregation": { "enum": ["none", "shared", "composite", null], "description": "An attribute's aggregation; null for an operation." },
        "opposite": { "type": ["string", "null"], "description": "Qualified name of the other end when the attribute is an end of a binary association (possibly an end the association itself owns), otherwise null." },
        "defaultValue": { "type": ["string", "null"], "description": "An attribute's default value in UML notation (e.g. \"false\", \"1\", \"*\", or an enumeration literal's name), or null when it has none." },
        "isQuery": { "type": "boolean", "description": "Always false for an attribute." },
        "isAbstract": { "type": "boolean", "description": "Whether the operation is abstract; always false for an attribute." }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name", "lower", "upper", "direction"],
      "properties": {
        "name": { "type": "string" },
        "typeName": { "type": ["string", "null"] },
        "typeQualifiedName": { "type": ["string", "null"] },
        "lower": { "type": "integer" },
        "upper": { "type": "string", "description": "\"*\" for unbounded, otherwise a non-negative integer as a string" },
        "direction": { "enum": ["in", "inout", "out"] }
      }
    },
    "constraint": {
      "type": "object",
      "required": ["languages", "body"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "languages": { "type": "array", "items": { "type": "string" } },
        "body": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classNode": {
      "type": "object",
      "required": ["name", "qualifiedName", "package", "isAbstract", "directSuperClasses", "directSubclasses", "allAncestors", "allDescendants", "ownedAttributes", "ownedOperations", "inheritedAttributes", "inheritedOperations", "constraints"],
      "properties": {
        "name": { "type": "string" },
        "qualifiedName": { "type": "string" },
        "package": { "type": "string" },
        "isAbstract": { "type": "boolean" },
        "directSuperClasses": { "type": "array", "items": { "type": "string" } },
        "directSubclasses": { "type": "array", "items": { "type": "string" } },
        "allAncestors": { "type": "array", "items": { "type": "string" } },
        "allDescendants": { "type": "array", "items": { "type": "string" } },
        "ownedAttributes": { "type": "array", "items": { "$ref": "#/definitions/feature" } },
        "ownedOperations": { "type": "array", "items": { "$ref": "#/definitions/feature" } },
        "inheritedAttributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/feature" },
          "description": "UML Classifier::inheritedMember restricted to attributes: every non-private attribute of every ancestor, minus those redefined by a more specific classifier."
        },
        "inheritedOperations": {
          "type": "array",
          "items": { "$ref": "#/definitions/feature" },
          "description": "UML Classifier::inheritedMember restricted to operations: every non-private operation of every ancestor, minus those redefined by a more specific classifier."
        },
        "constraints": { "type": "array", "items": { "$ref": "#/definitions/constraint" } }
      }
    },
    "enumerationNode": {
      "type": "object",
      "required": ["name", "qualifiedName", "package", "literals"],
      "properties": {
        "name": { "type": "string" },
        "qualifiedName": { "type": "string" },
        "package": { "type": "string" },
        "literals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "primitiveTypeNode": {
      "type": "object",
      "required": ["name", "qualifiedName", "package"],
      "properties": {
        "name": { "type": "string" },
        "qualifiedName": { "type": "string" },
        "package": { "type": "string" }
      }
    },
    "associationNode": {
      "type": "object",
      "description": "A metamodel association *link* between metaclasses (e.g. the association behind Class::ownedAttribute) - not a metaclass itself (see classNode for the Association metaclass).",
      "required": ["name", "qualifiedName", "package", "isAbstract", "isDerived", "memberEnds"],
      "properties": {
        "name": { "type": "string" },
        "qualifiedName": { "type": "string" },
        "package": { "type": "string" },
        "isAbstract": { "type": "boolean" },
        "isDerived": { "type": "boolean" },
        "memberEnds": { "type": "array", "items": { "$ref": "#/definitions/associationEnd" } }
      }
    },
    "associationEnd": {
      "type": "object",
      "required": ["name", "lower", "upper", "isOrdered", "isUnique", "isComposite", "isOwnedByAssociation", "isDerived", "aggregation", "isNavigable"],
      "properties": {
        "name": { "type": "string" },
        "typeName": { "type": ["string", "null"] },
        "typeQualifiedName": { "type": ["string", "null"] },
        "lower": { "type": "integer" },
        "upper": { "type": "string", "description": "\"*\" for unbounded, otherwise a non-negative integer as a string" },
        "isOrdered": { "type": "boolean" },
        "isUnique": { "type": "boolean" },
        "isComposite": { "type": "boolean" },
        "isOwnedByAssociation": {
          "type": "boolean",
          "description": "True when this end is one of the association's own ownedEnd properties (an end that neither endpoint classifier owns as its own attribute - usually non-navigable, see isNavigable); false when it's instead owned by one of the endpoint classifiers and already appears in that classifier's own ownedAttributes."
        },
        "isDerived": { "type": "boolean" },
        "aggregation": { "enum": ["none", "shared", "composite"] },
        "isNavigable": { "type": "boolean", "description": "UML Property::isNavigable(): the end is owned by a classifier, or is one of the association's navigableOwnedEnd." },
        "opposite": { "type": ["string", "null"], "description": "Qualified name of the other end of a binary association, otherwise null." }
      }
    }
  }
}
